{
  "openapi": "3.1.0",
  "info": {
    "title": "CouchOne Fit — identidad, cartera y expediente",
    "version": "2026-10-28",
    "description": "Contrato incremental. Web: mismo origen, cookie HttpOnly/Strict y Origin permitido + CSRF en mutaciones. Móvil: Bearer. Errores y respuestas no-store. CSPRNG32bytes/base64url43 y persistencia SHA-256; códigos nunca en URL/logs. HU-015 crea el expediente inicial completo sin crear credenciales. HU-016 añade búsqueda literal, estado, cursor y ficha mínima de lectura propia. HU-017 permite editar datos base propios con versión BD y conflictos explícitos, sin consumir cupo ni reescribir historial."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desarrollo local; producción requiere TLS."
    }
  ],
  "paths": {
    "/api/me/credentials": {
      "patch": {
        "operationId": "changeOwnCredentials",
        "summary": "HU-006: cambia usuario/clave propios, exige clave actual y revoca todas las sesiones.",
        "security": [
          {
            "bearerSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Credenciales actualizadas; reingreso obligatorio.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/clients": {
      "get": {
        "operationId": "listOwnClientAccess",
        "summary": "HU-016: cartera propia con búsqueda literal por nombre, estado y cursor; sin suscripción activa conserva lista vacía.",
        "security": [
          {
            "webSession": []
          },
          {
            "bearerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cartera privada.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "clients": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ClientRecord"
                      }
                    },
                    "hasClients": {
                      "type": "boolean",
                      "description": "Hay al menos un expediente en el ámbito propio visible, antes de búsqueda/estado/cursor."
                    },
                    "pageInfo": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "pageSize",
                        "hasMore",
                        "nextCursor"
                      ],
                      "properties": {
                        "pageSize": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "hasMore": {
                          "type": "boolean"
                        },
                        "nextCursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    "clients",
                    "hasClients",
                    "pageInfo"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Orden fijo created_at DESC, id DESC. Cursor firmado y ligado a cuenta, filtros y tamaño; no sustituye autorización. Unicode case-insensitive según lower de PostgreSQL, sin eliminar acentos. %, _, comillas y barras son literales. No ofrece instantánea congelada ante cambios concurrentes. Cambiar filtros requiere omitir cursor. Parámetros desconocidos o repetidos se rechazan. No devuelve medidas base en el listado.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Subcadena literal de fullName, recortada en extremos; máximo 150 puntos de código Unicode.",
            "schema": {
              "type": "string",
              "maxLength": 150,
              "default": ""
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Estado del expediente; vacío incluye ambos.",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "active",
                "inactive"
              ],
              "default": ""
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "nextCursor de la respuesta anterior con la misma cuenta y filtros.",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          }
        ]
      },
      "post": {
        "operationId": "createClientInitialRecord",
        "summary": "HU-015: crea un expediente inicial completo para el profesional autenticado.",
        "security": [
          {
            "webSession": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClientInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Expediente creado y cupo reservado en una sola transacción.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "client": {
                      "$ref": "#/components/schemas/ClientInitialRecord"
                    }
                  },
                  "required": [
                    "client"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "400 validación; 401 sesión; 403 rol, CSRF o suscripción; 409 cupo; 503 persistencia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/clients/{clientId}/invitations": {
      "parameters": [
        {
          "name": "clientId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "issueClientInvitation",
        "summary": "HU-007: genera o reemplaza; TTL7d; expediente propio activo no vinculado, profesional/sub activos. Sin segunda reserva.",
        "security": [
          {
            "webSession": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Código nuevo; anterior invalidado tras COMMIT.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeDelivery"
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "revokeClientInvitation",
        "summary": "Revoca la invitación del expediente propio.",
        "security": [
          {
            "webSession": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Temporal eliminado.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/activation/prevalidate": {
      "post": {
        "operationId": "prevalidateInvitation",
        "summary": "Anónimo. No consume ni expone expediente; canje revalida.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$",
                    "writeOnly": true
                  }
                },
                "required": [
                  "code"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Disponible en este instante.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "valid": {
                      "const": true
                    }
                  },
                  "required": [
                    "valid"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/activation": {
      "post": {
        "operationId": "activateClientAccount",
        "summary": "HU-008: cuenta+vínculo+aviso+DELETE atómicos; sesión después de COMMIT.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Activation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta activada; sesión móvil o guía de login si falla emisión posterior.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationResult"
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/recovery-targets": {
      "get": {
        "operationId": "listAuthorizedRecoveryTargets",
        "summary": "Solo clientes propios para profesional; profesionales/otros admins para admin. Nunca público.",
        "security": [
          {
            "webSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cuentas autorizadas.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "accounts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RecoveryTarget"
                      }
                    }
                  },
                  "required": [
                    "accounts"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{userId}/recovery": {
      "parameters": [
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "issueAssistedReset",
        "summary": "HU-009: operador autorizado corrobora relación conocida fuera de banda y reautentica. Reemplaza código anterior; TTL30min.",
        "security": [
          {
            "webSession": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Verification"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Código de entrega privada; el titular elige la clave.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeDelivery"
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/recovery/reset": {
      "post": {
        "operationId": "resetPassword",
        "summary": "HU-009: consume código separado, cambia clave y revoca sesiones en una transacción. No crea cuenta/expediente.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reset"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Contraseña cambiada; reingreso obligatorio.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/clients/{clientId}": {
      "get": {
        "operationId": "readOwnClientBaseRecord",
        "summary": "HU-016: lectura mínima de datos base de un cliente propio activo o inactivo.",
        "description": "Propiedad profesional y suscripción vigente comprobadas en servidor bajo RLS. Ajeno, inexistente o no disponible responden el mismo 404. UUID inválido: 400; sin sesión: 401; rol no profesional: 403. No implementa expediente consolidado ni edición.",
        "security": [
          {
            "webSession": []
          },
          {
            "bearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos base propios, no-store.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "client"
                  ],
                  "properties": {
                    "client": {
                      "$ref": "#/components/schemas/ClientBaseRecord"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Expediente no disponible, sin revelar su propietario.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error seguro. 400 datos/código no disponible; 401 sesión; 403 rol/CSRF/reautenticación; 409 identificador ocupado; 429 límite; 503 servicio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "editOwnClientBaseRecord",
        "summary": "HU-017: edición parcial de datos base propios con control de versión.",
        "description": "Profesional activo, suscripción vigente y propiedad comprobados en transacción/RLS. No consume cupo. No permite modificar estado, cuenta, propietario, historial o versión. Campos base completos no se vacían. Un 409 no guarda. Ante pérdida de respuesta el resultado es incierto: consultar GET y decidir explícitamente, sin repetición automática. Errores por campo en error.fields. Cache-Control: no-store.",
        "security": [
          {
            "webSession": []
          },
          {
            "bearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientRecordPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sin cambios o actualización confirmada; versión resultante.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "client"
                  ],
                  "properties": {
                    "client": {
                      "$ref": "#/components/schemas/ClientBaseRecord"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT; error.fields por campo cuando aplica.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "SESSION_REQUIRED: sesión no válida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "ROLE_FORBIDDEN, CSRF_INVALID, PLAN_REQUIRED o SUBSCRIPTION_SUSPENDED; un error de negocio no equivale a sesión revocada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "CLIENT_NOT_FOUND: mismo error para ajeno/inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "CLIENT_RECORD_CONFLICT: consultar versión actual y reaplicar mediante acción explícita.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: no se confirma éxito ni se repite automáticamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Errores de validación por campo; solo se devuelve para INVALID_INPUT de formularios."
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "description": "trim/lower, ASCII [a-z0-9._], 3–30 caracteres"
          },
          "currentPassword": {
            "type": "string",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "description": "15–128 puntos de código Unicode; sin trim, normalización ni truncamiento."
          },
          "passwordConfirmation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "username",
          "currentPassword",
          "password",
          "passwordConfirmation"
        ]
      },
      "Activation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailConfirmation": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "description": "15–128 puntos de código Unicode; sin trim, normalización ni truncamiento."
          },
          "passwordConfirmation": {
            "type": "string",
            "writeOnly": true
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "noticeVersion": {
            "const": "2026-10-15.1"
          },
          "acceptsNotice": {
            "const": true
          }
        },
        "required": [
          "username",
          "email",
          "emailConfirmation",
          "password",
          "passwordConfirmation",
          "code",
          "noticeVersion",
          "acceptsNotice"
        ]
      },
      "Reset": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
