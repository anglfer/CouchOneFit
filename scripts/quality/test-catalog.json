      "match": "\\b40[13]\\b|csrf|otra cartera|ajen|rol incorrecto|forbidden|idor|inyecci|sin sesi|no autoriz|privileg",
      "type": "seguridad"
    },
    {
      "match": "offline|sin conexi|reconex|reintent|recuper|conflict|caduc",
      "type": "recuperación"
    }
  ],
