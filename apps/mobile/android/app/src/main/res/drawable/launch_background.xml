<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de arranque: degradado de marca con el isotipo en blanco -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white">
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#3046EB"
                android:centerColor="#4037F7"
                android:endColor="#6344DC" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
