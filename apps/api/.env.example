PORT=3000
NODE_ENV=development
# Origenes exactos de la web local permitidos para registro y proteccion CSRF.
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
# Conexion PostgreSQL de servidor; en remoto exigir TLS con certificado verificado.
# Usuario dedicado miembro de couchone_authentication; nunca enviar al navegador.
DATABASE_URL=postgresql://couchone_api:CAMBIAR@localhost:5432/CouchOneFit_dev
# Supabase: conservar host/usuario/clave del proyecto y agregar estos parametros:
# ?sslmode=verify-full&sslrootcert=certs/supabase-root-2021.crt
# La CA publica esta versionada; ruta relativa al ejecutar scripts desde apps/api.
# Solo pruebas: base LOCAL vacia y exclusiva; aplicar antes las migraciones.
TEST_DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/CouchOneFit_test
# Secreto aleatorio exclusivo de servidor de al menos 32 bytes. Sin valor versionado.
AUTH_JWT_SECRET=
