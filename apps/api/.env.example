PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5000
# Conexion PostgreSQL de servidor; en remoto exigir TLS con certificado verificado.
# Usuario dedicado miembro de couchone_autenticacion; nunca enviar al navegador.
DATABASE_URL=postgresql://couchone_api:CAMBIAR@localhost:5432/CouchOneFit_dev
# Solo pruebas: base LOCAL vacia y exclusiva; aplicar antes las migraciones.
TEST_DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/CouchOneFit_test
# Secreto aleatorio exclusivo de servidor de al menos 32 bytes. Sin valor versionado.
AUTH_JWT_SECRET=
